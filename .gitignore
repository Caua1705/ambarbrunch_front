# nunca versionada. O build de produção não a referencia e o podador do astro.config a remove do dist.
public/media/revisao/
src/assets/media/revisao/

# Painel administrativo: build com o painel ligado (scripts/painel.mjs) e saída do adaptador da Vercel
dist-painel/
.vercel/

# Build de teste da reserva em modo API (tests-reservas/)
dist-reservas-api/
