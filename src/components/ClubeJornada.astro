---
// Passaporte Âmbar (2026-10-22) — a prévia do Clube no lugar da carteira em forma de cartão: uma página de passaporte
// com a trilha da Jornada Âmbar, um carimbo por marco. É uma PRÉVIA CONCEITUAL: não simula cliente (sem nome, número,
// saldo ou progresso) e só afirma o que já está decidido; aniversário e recompensas aparecem “em definição” enquanto
// estiverem pendentes em data/clube.ts. No rodapé, “Chamar alguém”: compartilha o link do Clube (Web Share; sem ele, copia).
// Usado no convite da home e no topo de /clube. Os carimbos batem em sequência ao entrar (motion.css §6).
import { clube } from '../data/clube';
import { isPendente } from '../lib/conteudo';

interface Props { class?: string }
const { class: cls } = Astro.props;

// traços de 24 × 24, na linha dos ícones desenhados do site (stroke, pontas redondas)
const ICONES: Record<string, string> = {
  telefone: 'M8.5 3h7a1.5 1.5 0 0 1 1.5 1.5v15a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 19.5v-15A1.5 1.5 0 0 1 8.5 3zM11 18h2',
  xicara: 'M5 10h11v4a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5zM16 11.5h1.2a2.3 2.3 0 0 1 0 4.6H16M8.5 3.5c-.8 1 .8 1.8 0 3M12.5 3.5c-.8 1 .8 1.8 0 3',
  espiral: 'M12 12.5c.9 0 1.2-1.3.2-1.6-1.6-.4-2.6 1.6-1.5 2.8 1.6 1.7 4.6.6 4.6-1.9 0-3.3-4.2-4.6-6.5-2.4-3 2.8-1.2 8 3.2 8 4.6 0 7-4.6 5.6-8.4',
  bolo: 'M4 20.5h16M5.5 20.5V13h13v7.5M5.5 16.5c2.2 1.4 4.3 1.4 6.5 0s4.3-1.4 6.5 0M12 13V9.5M12 7c-.9-.8-.9-1.9 0-3 .9 1.1.9 2.2 0 3z',
  presente: 'M4 9.5h16v3.5H4zM5.5 13h13v7.5h-13zM12 9.5v11M12 9.5C10.6 6.6 7 6 7 8s3 1.5 5 1.5zM12 9.5c1.4-2.9 5-3.5 5-1.5s-3 1.5-5 1.5z',
};

const marcos = clube.jornada.map((m) => {
  const pend = m.definicao ? isPendente(clube[m.definicao]) : false;
  return { ...m, pend };
});
---
<div class:list={['jornada', cls]} data-reveal="piece">
  <p class="jornada__topo">
    <span class="jornada__marca">Passaporte Âmbar</span>
    <span class="jornada__previa">prévia</span>
  </p>
  <ol class="jornada__trilha" aria-label="Jornada Âmbar: como o Clube funciona">
    {marcos.map((m, i) => (
      <li class:list={['marco', m.pend && 'marco--definicao']} style={`--i:${i}`}>
        <span class="marco__selo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={ICONES[m.icone]} /></svg></span>
        <span class="marco__txt">
          <strong>{m.titulo}</strong>
          <span>{m.pend ? 'em definição' : m.texto}</span>
        </span>
      </li>
    ))}
  </ol>
  <p class="jornada__rodape">
    <span class="jornada__chamada">conhece alguém que faria do Âmbar um hábito?</span>
    <button type="button" class="jornada__compartilhar" data-compartilhar="/clube/">chamar pro Clube <span aria-hidden="true">↗</span></button>
    <span class="jornada__aviso" role="status" data-compartilhar-aviso></span>
  </p>
</div>

<script>
  // Compartilhar o Clube: a folha nativa do celular quando existe; senão copia o link e avisa. Nada é guardado ou enviado
  // pelo site — quem compartilha escolhe o app.
  document.querySelectorAll<HTMLButtonElement>('[data-compartilhar]').forEach((b) => {
    const aviso = b.parentElement?.querySelector<HTMLElement>('[data-compartilhar-aviso]');
    b.addEventListener('click', async () => {
      const url = new URL(b.dataset.compartilhar || '/clube/', location.origin).href;
      try {
        if (navigator.share) { await navigator.share({ title: 'Clube Âmbar', text: 'O Clube do Âmbar Brunch, direto no navegador.', url }); return; }
        await navigator.clipboard.writeText(url);
        if (aviso) aviso.textContent = 'link copiado';
      } catch (e) {
        if ((e as DOMException)?.name !== 'AbortError' && aviso) aviso.textContent = url;
      }
    });
  });
</script>
