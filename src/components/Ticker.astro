---
// Faixa de categorias inclinada, em loop (v1: .ticker). Decorativa (aria-hidden): as categorias também estão no cardápio.
interface Props { itens: string[] }
const faixa = Astro.props.itens.map((c) => `${c} ✺ `).join('');
---
<div class="ticker" aria-hidden="true">
  <div class="ticker__track"><span>{faixa}</span><span>{faixa}</span></div>
</div>
