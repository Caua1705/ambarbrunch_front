---
// Vídeo vertical (v1: .story) com etiqueta, progresso e tocar/pausar. Sem @ nem crédito sobreposto pelo site: o que o
// próprio vídeo traz gravado (legenda, @ do criador ou da Roll) fica como está.
// O vídeo começa mudo, preload="none"; o poster (data-poster) só baixa quando o carrossel se aproxima
// da tela — o atributo poster baixaria a imagem já no carregamento da página — e o vídeo só quando o card vai tocar.
// `carrossel` (Reações reais — quem toca é lib/carrossel.js): card limpo — só o vídeo e o botão de som (o arquivo mantém
// a voz original). Sem legenda/transcrição nem CC (rodada final): o vídeo fala por si. `pos` = lugar do card no palco
// (0 = central, ±1 = vizinhos à vista, ±2 = fora da tela); os três à vista tocam juntos, cada um repetindo o próprio
// corte (o corte em si não tem emenda nem repetição montada). Tocar no vídeo central liga/desliga o som (referência
// Zuzzi): o vídeo não pausa e não aparece play/pause no meio.
// Sem barra de progresso: com dois vídeos tocando ela custava ~13% da thread principal num celular intermediário.
// Formato horizontal: janela emoldurada dentro do card, sem zoom.
import { getImage } from 'astro:assets';
import { imagem, video } from '../lib/media';
import { isPendente, type Pendente } from '../lib/conteudo';

interface Props {
  arquivo: string; poster: string; tag: string; descricao: string;
  autor?: string | Pendente; tipo: 'roll' | 'criador'; quando?: string;
  formato?: 'vertical' | 'horizontal'; audio?: boolean; carrossel?: boolean; pos?: number;
}
const { arquivo, poster, tag, descricao, autor, tipo, formato = 'vertical', audio = false, carrossel = false, pos = 0 } = Astro.props;
const src = video(arquivo);
const meta = imagem(poster);
const posterUrl = meta ? (await getImage({ src: meta, width: formato === 'horizontal' ? 640 : 480, format: 'webp', quality: 64 })).src : undefined;
// sem @ identificado (ou ainda pendente): o card não mostra nome — nunca um aviso no lugar
const quem = !autor || isPendente(autor) ? undefined : autor;
const [w, h] = formato === 'horizontal' ? [480, 268] : [540, 960];
// nome do vídeo nos rótulos dos botões (a etiqueta visível saiu do carrossel)
// no carrossel o rótulo descreve a cena (sem @ do criador, nem para leitor de tela)
const deQuem = carrossel || !quem ? `(${descricao})` : `de ${quem}`;
---
{src && carrossel && (
  <li class:list={['story', 'story--feed', formato === 'horizontal' && 'story--wide']} data-tipo={tipo} data-audio={audio ? '' : undefined}
    data-pos={Math.max(-2, Math.min(2, pos))} data-ativo={pos === 0 ? '' : undefined} inert={Math.abs(pos) > 1}>
    <div class="story__janela">
      <!-- capa leve (img lazy) e o <video> num <template>, criado só quando o card vai tocar —
           cada <video> custa caro no carregamento do WebKit, mesmo com preload="none" -->
      {posterUrl && <img class="story__poster" src={posterUrl} alt="" loading="lazy" decoding="async" draggable="false" width={w} height={h} />}
      <template data-video>
        <video muted playsinline loop preload="none" data-carrossel poster={posterUrl} aria-label={`Vídeo: ${descricao}`} width={w} height={h}>
          <source src={src} type="video/mp4" />
        </video>
      </template>
    </div>
    <!-- superfície de toque (só ponteiro): no central liga/desliga o SOM, nunca pausa; num vizinho, traz para o centro.
         Teclado e leitor de tela usam o botão de som (abaixo), as setas e os pontos. -->
    <div class="story__toggle" data-superficie aria-hidden="true"></div>
    {audio && (
      <button class="story__som" type="button" aria-pressed="false" aria-label={`Ativar o som do vídeo ${deQuem}`} data-som data-nome={deQuem}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="story__som-alto" d="M4 9h4l5-4v14l-5-4H4zM16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12" /><path class="story__som-mudo" d="M4 9h4l5-4v14l-5-4H4zM16.5 9.5l5 5M21.5 9.5l-5 5" /></svg>
      </button>
    )}
  </li>
)}
{src && !carrossel && (
  <li class:list={['story', formato === 'horizontal' && 'story--wide']} data-tipo={tipo} data-audio={audio ? '' : undefined}>
    <i class="story__progress" aria-hidden="true"></i>
    <div class="story__janela">
      <video muted playsinline loop preload="none" data-autoplay data-poster={posterUrl} aria-label={`Vídeo: ${descricao}`} width={w} height={h}>
        <source src={src} type="video/mp4" />
      </video>
    </div>
    <button class="story__toggle" type="button" aria-pressed="false" aria-label={`Tocar ou pausar o vídeo: ${tag}`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
    </button>
    <p class="story__tag">{tag}</p>
  </li>
)}
