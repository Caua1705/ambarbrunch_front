---
// Ícone de traço de uma categoria do cardápio: a apresentação neutra do produto sem foto real, no lugar de uma imagem inventada.
// Decorativo: o nome do produto já está ao lado.
import { Citrus, Croissant, CakeSlice, Coffee, CupSoda, EggFried, GlassWater, Sandwich, Soup } from 'lucide-preact';
import type { Icone } from '../data/cardapio';

interface Props { icone: Icone }
const { icone } = Astro.props;
const ICONES = {
  croissant: Croissant, prato: EggFried, sanduiche: Sandwich, bowl: Soup, fatia: CakeSlice,
  cafe: Coffee, gelado: CupSoda, suco: Citrus, lata: GlassWater,
};
const Traco = icone === 'roll' ? null : ICONES[icone];
---
{Traco
  ? <Traco size={30} strokeWidth={1.5} aria-hidden="true" />
  : <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 12c0-1.1.9-2 2-2s2 .9 2 2c0 2.2-1.8 4-4 4s-4-1.8-4-4c0-3.3 2.7-6 6-6s6 2.7 6 6c0 4.4-3.6 8-8 8s-8-3.6-8-8" /></svg>}
