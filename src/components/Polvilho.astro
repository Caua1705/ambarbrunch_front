---
// Polvilho (acabamento de 2026-10-18): grãos de açúcar caindo devagar no topo da Fornada, atrás do conteúdo. Decorativo.
// Posições fixas (sem aleatório no build): cada grão tem coluna --x, tamanho --s, velocidade --k, atraso --d e opacidade --o.
// Só roda na tela (data-vivo) e some com movimento reduzido (motion.css).
const GRAOS = [
  [6, 3, 1.1, -2.1, .5], [14, 2, .9, -7.4, .4], [22, 4, 1.3, -4.6, .55], [31, 2, 1, -9.8, .35],
  [39, 3, .85, -1.2, .5], [47, 2, 1.2, -6.3, .4], [55, 4, 1.05, -3.7, .5], [63, 2, .95, -8.9, .45],
  [71, 3, 1.25, -5.2, .55], [79, 2, .9, -.6, .35], [87, 3, 1.15, -7.7, .5], [94, 2, 1, -3.1, .4],
];
---
<div class="polvilho" aria-hidden="true" data-vivo>
  {GRAOS.map(([x, s, k, d, o], i) => (
    <i style={`--x:${x}%;--s:${s}px;--k:${k};--d:${(d * 11).toFixed(1)}s;--o:${o};--vento:${i % 2 ? 12 : -9}px`}></i>
  ))}
</div>
