---
// Folha do menu (<dialog> modal nativo): logo, seções, “Reservar mesa” (o único botão cheio) e fechar.
// Rodada final: sem endereço, horário e contatos (endereço e horário na Visite; WhatsApp e Instagrams no rodapé). Entrada e saída animadas em lib/nav-sheet.js.
import Foto from './Foto.astro';
import MenuButton from './MenuButton.astro';

interface Props { base?: string }
const { base = '' } = Astro.props;   // '' na home (âncoras locais), '/' nas páginas internas
const itens = [
  { href: `${base}#gastronomia`, texto: 'Cardápio' },
  { href: `${base}#roll`, texto: 'Fornada' },
  { href: `${base}#cafe-roll`, texto: 'Café + Roll' },
  { href: `${base}#saladas`, texto: 'Saladas & bowls' },
  { href: `${base}#quem-provou`, texto: 'Reações reais' },
  { href: `${base}#ambientes`, texto: 'Ambientes' },
  { href: `${base}#visite`, texto: 'Visite' },
];
---
<dialog class="sheet" id="menu" aria-label="Menu">
  <div class="sheet__head">
    <Foto src="brand/logo-ambar.png" alt="Âmbar Brunch" class="sheet__logo" sizes="132px" widths={[132, 264, 396]} qualidade={80} eager />
    <MenuButton variante="close" />
  </div>
  <nav aria-label="Seções do site">
    <ol class="sheet__nav">
      {itens.map((i) => <li><a href={i.href}>{i.texto}</a></li>)}
    </ol>
  </nav>
  <a class="btn btn--wine btn--block sheet__cta" href={`${base}#reservar`}>Reservar mesa <span aria-hidden="true">→</span></a>
</dialog>
