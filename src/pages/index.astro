---
// Homepage — ordem final (2026-10-20, sem a seção Saladas & bowls): hero e faixa · novo capítulo · para sua mesa ·
// direto da fornada · café + roll · reações reais · escolha seu lugar · reserve sua mesa · clube âmbar (convite curto,
// 2026-10-20; sobre a foto do Clube desde 2026-10-23) · rodapé, que absorveu a antiga “Visite o Âmbar” (2026-10-23).
// Ritmo de fundos: vinho · manteiga · creme · cacau · caramelo · vinho · manteiga · vinho · papel da foto · creme.
import Base from '../layouts/Base.astro';
import Hero from '../sections/Hero.astro';
import NovoCapitulo from '../sections/NovoCapitulo.astro';
import MesaCheia from '../sections/MesaCheia.astro';
import Fornadas from '../sections/Fornadas.astro';
import CafeRoll from '../sections/CafeRoll.astro';
import QuemProvou from '../sections/QuemProvou.astro';
import Climas from '../sections/Climas.astro';
import Reserva from '../sections/Reserva.astro';
import ClubeConvite from '../sections/ClubeConvite.astro';
import Footer from '../sections/Footer.astro';
// 2026-10-27: o convite do Clube só entra com PUBLIC_CLUBE_HOME=1 (lib/clube-modo.ts); por padrão a reserva vai ao rodapé
import { CLUBE_NA_HOME } from '../lib/clube-modo';
// SEO local (2026-10-30): o café como negócio local para o Google (src/data/seo.ts)
import { dadosEstruturados, imagensSeo, jsonLd } from '../data/seo';

const ld = dadosEstruturados(await imagensSeo());
---
<Base>
  <script type="application/ld+json" slot="head" set:html={jsonLd(ld)} />
  <Hero />
  <main>
    <NovoCapitulo />
    <MesaCheia />
    <Fornadas />
    <CafeRoll />
    <QuemProvou />
    <Climas />
    <Reserva />
    {CLUBE_NA_HOME && <ClubeConvite />}
  </main>
  <Footer />
</Base>
