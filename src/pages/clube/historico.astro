---
// /clube/historico — histórico de pontos (em preparação até o backend publicar a rota). Área do membro (sections/ClubeAreaMolde + islands/ClubeArea): a sessão é
// conferida na ilha; sem sessão, vai para /clube/entrar/ e volta para cá. Fora dos buscadores.
import Base from '../../layouts/Base.astro';
import ClubeAreaMolde from '../../sections/ClubeAreaMolde.astro';
import ClubeArea from '../../islands/ClubeArea';
import { CLUBE_MODO, CLUBE_API_URL, CLUBE_ABERTO } from '../../lib/clube-modo';
---
<Base titulo="Histórico — Clube Âmbar" descricao="Histórico no Clube Âmbar." home={false} indexar={false}>
  <ClubeAreaMolde atual="historico" titulo="Histórico">
    {CLUBE_ABERTO
      ? <ClubeArea client:load secao="historico" modo={CLUBE_MODO} apiUrl={CLUBE_API_URL} />
      : <ClubeArea secao="historico" modo={CLUBE_MODO} />}
  </ClubeAreaMolde>
</Base>
