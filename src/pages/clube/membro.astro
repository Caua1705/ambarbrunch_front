---
// /clube/membro — área de membro do Clube Âmbar: acesso pelo telefone (código) e carteira (saldo, histórico,
// recompensas, novidades). Sem a API do Clube, mostra o acesso desligado e uma prévia SEM dados (islands/ClubeMembro.tsx).
// Fora dos buscadores: é uma página pessoal.
import Base from '../../layouts/Base.astro';
import Foto from '../../components/Foto.astro';
import Footer from '../../sections/Footer.astro';
import ClubeMembro from '../../islands/ClubeMembro';
import { CLUBE_MODO, CLUBE_API_URL } from '../../lib/clube-modo';
---
<Base titulo="Minha carteira — Clube Âmbar" home={false} indexar={false}>
  <header class="page-bar">
    <a href="/" aria-label="Âmbar Brunch — voltar ao início"><span class="label"><Foto src="brand/logo-ambar.png" alt="Âmbar Brunch" sizes="122px" widths={[122, 244, 366]} prioridade qualidade={80} /></span></a>
    <a class="page-back" href="/clube/">← clube</a>
  </header>
  <main class="clube">
    <section class="clube-membro surface-grain surface-dark" aria-labelledby="membro-h1">
      <h1 class="titulo titulo--light" id="membro-h1" data-reveal="lines"><span>Sua</span><span class="mega__r">carteira</span></h1>
      <ClubeMembro client:load modo={CLUBE_MODO} apiUrl={CLUBE_API_URL} />
    </section>
  </main>
  <Footer />
</Base>
