---
// /clube/estados/ — página INTERNA de revisão: cada estado da ficha de inscrição e da carteira, lado a lado, para
// aprovar o desenho antes da integração com a API do Clube. Só no `astro dev` e nos builds de revisão (getStaticPaths
// vazio em produção, como /design-system/). Os componentes são renderizados no servidor com estado forçado (`demo`):
// nada é interativo, nada é enviado. Sem número de pontos: nome e número são marcações de lugar e o saldo fica em traço.
import Base from '../../../layouts/Base.astro';
import Footer from '../../../sections/Footer.astro';
import ClubeCadastro, { type DemoFicha } from '../../../islands/ClubeCadastro';
import ClubeMembro, { type DemoMembro } from '../../../islands/ClubeMembro';
import type { DesafioCodigo, Membro } from '../../../lib/api/clube-contrato';
import type { CadastroPendente, DesafioAcesso, MembroClube } from '../../../lib/api/clube-acesso';
import { REVISAO } from '../../../lib/conteudo';

export function getStaticPaths() {
  return REVISAO ? [{ params: { x: undefined } }] : [];
}

const desafio: DesafioCodigo = { desafioId: 'demo', canal: 'whatsapp', destino: '(85) •••••-0000', reenvioEm: 30 };
const membro: Membro = { nome: 'Nome Exemplo', numero: '0000 0000', desde: '2026-10-20', saldo: null, marketing: { autorizado: false } };

const acesso: DesafioAcesso = { desafioId: 'demo', canal: 'whatsapp', destino: '(85) •••••-0000', reenvioEm: 30, expiraEm: '2026-10-23T12:00:00Z' };
const membroClube: MembroClube = { nome: 'Nome Exemplo', telefone: '(85) •••••-0000', aniversario: null, membroDesde: '2026-10-23', marketing: { autorizado: false }, mensagens: { autorizado: true }, programa: { ativo: false, saldo: null } };
const novo: CadastroPendente = { nome: null, aniversario: null, faltam: ['nome', 'aceite'], marketing: { autorizado: false } };
const incompleto: CadastroPendente = { nome: 'Nome Exemplo', aniversario: '03-14', faltam: ['aceite'], marketing: { autorizado: true } };

// entrada única pelo WhatsApp (2026-10-23): telefone → código → cadastro só do que falta → membro
const fichas: { titulo: string; demo: DemoFicha }[] = [
  { titulo: 'Entrada · fechada (padrão do site hoje)', demo: { etapa: 'fechado' } },
  { titulo: 'Entrada · carregando as regras', demo: { etapa: 'carregando' } },
  { titulo: 'Entrada · WhatsApp', demo: { etapa: 'telefone' } },
  { titulo: 'Entrada · WhatsApp inválido', demo: { etapa: 'telefone', telefone: '(85) 9000', erros: { telefone: 'Confira o WhatsApp com DDD, ex.: (85) 99999-9999.' } } },
  { titulo: 'Entrada · enviando o código', demo: { etapa: 'enviando', telefone: '(85) 90000-0000' } },
  { titulo: 'Entrada · código', demo: { etapa: 'codigo', desafio: acesso } },
  { titulo: 'Entrada · código incorreto', demo: { etapa: 'codigo', desafio: acesso, erros: { codigo: 'Código incorreto. Confira e tente de novo.' } } },
  { titulo: 'Cadastro · cliente novo (nome, aniversário, termos, novidades)', demo: { etapa: 'cadastro', cadastro: novo } },
  { titulo: 'Cadastro · incompleto (só os termos atuais)', demo: { etapa: 'cadastro', cadastro: incompleto, dados: { nome: 'Nome Exemplo', aceite: false } } },
  { titulo: 'Cadastro · campos com erro', demo: { etapa: 'cadastro', cadastro: novo, dados: { nome: 'A', aniversario: '31/02' }, erros: { nome: 'Diga como podemos chamar você.', aniversario: 'Use dia e mês, ex.: 25/12 — ou deixe em branco.', aceite: 'Para entrar no Clube, aceite a política de privacidade e o regulamento.' } } },
  { titulo: 'Membro · acabou de entrar (só com resposta da API)', demo: { etapa: 'membro', membro: membroClube, novo: true } },
  { titulo: 'Membro · já era do Clube', demo: { etapa: 'membro', membro: membroClube } },
  { titulo: 'Entrada · falha', demo: { etapa: 'falha', falha: 'O Clube está indisponível no momento. Tente mais tarde.' } },
];
const carteiras: { titulo: string; demo: DemoMembro }[] = [
  { titulo: 'Carteira · acesso desligado + prévia (padrão do site hoje)', demo: { etapa: 'indisponivel' } },
  { titulo: 'Carteira · conferindo a sessão', demo: { etapa: 'carregando' } },
  { titulo: 'Carteira · entrar com o telefone', demo: { etapa: 'entrar' } },
  { titulo: 'Carteira · código', demo: { etapa: 'codigo', desafio } },
  { titulo: 'Carteira · falha ao abrir', demo: { etapa: 'falha', erro: 'Sem conexão com o Clube.' } },
  { titulo: 'Carteira · aberta, carregando histórico e recompensas', demo: { etapa: 'carteira', membro, extrato: { estado: 'carregando', itens: [] }, recompensas: { estado: 'carregando', itens: [] } } },
  { titulo: 'Carteira · aberta, membro novo (sem compras, recompensas em definição)', demo: { etapa: 'carteira', membro, extrato: { estado: 'ok', itens: [], proximo: null }, recompensas: { estado: 'ok', itens: [], publicadas: false } } },
  { titulo: 'Carteira · erro no histórico', demo: { etapa: 'carteira', membro, extrato: { estado: 'erro', itens: [], msg: 'Não foi possível carregar o histórico.' }, recompensas: { estado: 'ok', itens: [], publicadas: false } } },
];
---
<Base titulo="Estados do Clube — revisão" home={false} indexar={false}>
  <main class="clube clube-estados">
    <header class="clube-estados__topo">
      <h1>Clube Âmbar · estados</h1>
      <p>Página interna de revisão. Cada quadro é um estado forçado da ficha ou da carteira: nada aqui é real, interativo ou enviado.
        Hoje, sem a API do Clube, o site mostra só os quadros marcados “padrão do site hoje”.</p>
    </header>
    <div class="clube-estados__grade">
      {fichas.map((f, i) => (
        <section class="clube-estados__quadro">
          <h2>{f.titulo}</h2>
          <ClubeCadastro modo="indisponivel" privacidadeUrl="/privacidade/" ids={`ef${i}`} demo={f.demo} />
        </section>
      ))}
    </div>
    <div class="clube-estados__grade">
      {carteiras.map((c, i) => (
        <section class="clube-estados__quadro clube-estados__quadro--largo">
          <h2>{c.titulo}</h2>
          <ClubeMembro modo="indisponivel" ids={`em${i}`} demo={c.demo} />
        </section>
      ))}
    </div>
  </main>
  <Footer />
</Base>
