---
// /reservar — a mesma comanda, em página própria (links do Instagram, QR code).
import Base from '../layouts/Base.astro';
import PageBar from '../components/PageBar.astro';
import Reserva from '../sections/Reserva.astro';
import Footer from '../sections/Footer.astro';
---
<Base titulo="Reservar mesa — Âmbar, cafeteria e brunch no Meireles, Fortaleza" descricao="Reserve sua mesa no Âmbar, cafeteria e brunch no Meireles, em Fortaleza: escolha o ambiente, a data e o horário. Aberto de terça a domingo, das 07h às 19h." home={false} social={{ titulo: 'Reservar mesa — Âmbar Brunch', descricao: 'Reserve sua mesa no Âmbar Café & Brunch.', imagem: '/og/reservar.jpg', alt: 'Logo do Âmbar Café & Brunch com o convite para reservar uma mesa' }}>
  <PageBar nome="Âmbar Brunch" voltar prioridade />
  <main>
    <Reserva titulo="h1" />
  </main>
  <Footer />
</Base>
