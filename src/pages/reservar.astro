---
// /reservar — a mesma comanda, em página própria (links do Instagram, QR code).
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Reserva from '../sections/Reserva.astro';
import Footer from '../sections/Footer.astro';
---
<Base titulo="Reservar mesa — Âmbar Café, Meireles, Fortaleza" descricao="Reserve sua mesa no Âmbar Café, no Meireles, em Fortaleza: escolha o ambiente, a data e o horário. Brunch, café e cinnamon rolls todos os dias, das 07h às 19h." home={false}>
  <header class="page-bar">
    <a href="/" aria-label="Âmbar Brunch — voltar ao início"><span class="label"><Foto src="brand/logo-ambar.png" alt="Âmbar Brunch" sizes="122px" widths={[122, 244, 366]} prioridade qualidade={80} /></span></a>
    <a class="page-back" href="/">← início</a>
  </header>
  <main>
    <Reserva titulo="h1" />
  </main>
  <Footer />
</Base>
