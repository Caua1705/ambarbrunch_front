---
// /cardapio — o cardápio completo: produtos, descrições, preços e adicionais vêm do catálogo oficial do backend no build
// (lib/cardapio/catalogo.ts); esta página só apresenta. O PDF em public/cardapio/ é gerado do mesmo catálogo (npm run cardapio:pdf) e
// mantém o mesmo endereço. Esta URL e o preview são os que o WhatsApp envia: não mudar (docs/technical/PREVIEW-LINKS.md).
import Base from '../layouts/Base.astro';
import PageBar from '../components/PageBar.astro';
import CardapioCompleto from '../sections/CardapioCompleto.astro';
import Footer from '../sections/Footer.astro';
import { montarCardapio } from '../data/cardapio';
import { carregarCatalogo } from '../lib/cardapio/catalogo';
import { jsonLd, menuEstruturado } from '../data/seo';

const cardapio = montarCardapio(await carregarCatalogo());
---
<Base
  titulo="Cardápio — Âmbar, cafeteria e brunch no Meireles, Fortaleza"
  descricao="Cardápio completo do Âmbar Café & Brunch, no Meireles, em Fortaleza: croissants, brunchs, sanduíches, bowls, cafés, cinnamon rolls e cheesecakes, com preços."
  home={false}
  social={{
    titulo: 'Cardápio — Âmbar Brunch',
    descricao: 'Confira o cardápio do Âmbar Café & Brunch.',
    imagem: '/og/cardapio.jpg',
    alt: 'Logo do Âmbar Café & Brunch com o título Cardápio',
  }}
>
  <script is:inline slot="head">if(location.hash)document.documentElement.style.scrollBehavior='auto';</script>
  <PageBar nome="Âmbar Brunch" voltar prioridade />
  <CardapioCompleto cardapio={cardapio} />
  <Footer />
  <script is:inline type="application/ld+json" set:html={jsonLd(menuEstruturado(cardapio))} />
</Base>
