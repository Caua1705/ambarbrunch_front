---
// /reserva-confirmada — tela final da reserva feita pelo site, separada da landing (sem formulário, menu, botão fixo nem
// rodapé). A comanda guarda a reserva criada no sessionStorage da aba e troca de página (location.replace); esta página
// só lê (islands/ReservaConfirmada). Fora dos buscadores.
import Base from '../layouts/Base.astro';
import PageBar from '../components/PageBar.astro';
import ReservaConfirmada from '../islands/ReservaConfirmada';
---
<Base titulo="Reserva confirmada — Âmbar Café" descricao="Confirmação da reserva no Âmbar Café." home={false} indexar={false} enxuta>
  <div class="confirmada">
  <PageBar nome="Âmbar Café" prioridade />
  <main class="reserva reserva--confirmada">
    <ReservaConfirmada client:load />
  </main>
  </div>
</Base>
