---
// Cardápio completo (/cardapio/): navegação fixa por categoria e, em cada uma, os produtos com imagem ou a apresentação neutra. Tocar na linha do
// produto abre o modal com a imagem ampliada (scripts/cardapio-modal.js). Sem JS, a navegação são âncoras comuns; o script só marca a categoria da vez
// e leva a etiqueta dela para dentro da faixa (scripts/cardapio-nav.js).
import Foto from '../components/Foto.astro';
import IconeCardapio from '../components/IconeCardapio.astro';
import type { Cardapio, CategoriaVista, GrupoVista } from '../data/cardapio';
import { secoes } from '../data/secoes';
import { imagem } from '../lib/media';

interface Props { cardapio: Cardapio }
const { cardapio } = Astro.props;
const PDF = '/cardapio/cardapio-ambar.pdf';
const grupos = [
  { id: 'comer', rotulo: 'pra comer', categorias: cardapio.comer },
  { id: 'beber', rotulo: 'pra beber', categorias: cardapio.beber },
];
const temAdicionais = cardapio.adicionaisBebidas.length > 0;
/** só as primeiras miniaturas estão na primeira tela: nelas o carregamento não espera a rolagem */
const MINIATURAS_IMEDIATAS = 3;
const imediata = (categoria: CategoriaVista, n: number) => categoria === cardapio.comer[0] && n < MINIATURAS_IMEDIATAS;
---
<main class="carta">
  <header class="carta__topo">
    <h1>Cardápio</h1>
    <p class="carta__sub">{secoes.mesa.sub}</p>
  </header>

  <nav class="carta__nav" aria-label="Categorias do cardápio" data-carta-nav>
    <ul>
      {[...cardapio.comer, ...cardapio.beber].map((c) => <li><a href={`#${c.ancora}`}>{c.nome}</a></li>)}
      {temAdicionais && <li><a href="#adicionais">Adicionais</a></li>}
    </ul>
  </nav>

  {grupos.map((g) => (
    <div class="carta__grupo">
      <p class="carta__rotulo">{g.rotulo}</p>
      {g.categorias.map((c: CategoriaVista) => (
        <section class="categoria" id={c.ancora} aria-labelledby={`titulo-${c.ancora}`} data-carta-secao>
          <header class="categoria__topo">
            <h2 id={`titulo-${c.ancora}`}>{c.nome}</h2>
            {c.observacao && <p>{c.observacao}</p>}
          </header>
          <ul class="pratos">
            {c.produtos.map((p, n) => (
              <li class="prato" data-item={p.id} data-preco={p.precoCentavos} data-sem-foto={p.foto ? undefined : ''}>
                <div class="prato__foto">
                  {p.foto && imagem(p.foto.src)
                    ? <Foto src={p.foto.src} alt={p.foto.alt} sizes="(min-width: 720px) 88px, 64px" widths={[88, 176, 264]} qualidade={50} eager={imediata(c, n)} semPrevia />
                    : <IconeCardapio icone={c.icone} />}
                </div>
                <div class="prato__texto">
                  <h3><button type="button" class="prato__abrir" data-abrir-produto aria-haspopup="dialog">{p.nome}</button></h3>
                  {p.descricao && <p>{p.descricao}</p>}
                </div>
                <p class="prato__preco">{p.preco}</p>
                {p.foto && imagem(p.foto.ampliada) && (
                  <template>
                    <div class="produto-modal__quadro" style={`--natural:${imagem(p.foto.ampliada)!.width}px`}>
                      <Foto src={p.foto.ampliada} alt={p.foto.alt} sizes="(min-width: 480px) 440px, calc(100vw - 32px)" widths={[480, 720, 960, 1200]} qualidade={72} eager semPrevia />
                    </div>
                  </template>
                )}
              </li>
            ))}
          </ul>
          {c.adicionais.map((a: GrupoVista) => (
            <aside class="adicional" aria-label={a.nome}>
              <h3>{a.nome}</h3>
              <ul class="precos">
                {a.itens.map((i) => <li data-item={i.id} data-preco={i.precoCentavos}><span class="precos__nome">{i.nome}</span><i aria-hidden="true"></i><span class="precos__valor">{i.preco}</span></li>)}
              </ul>
            </aside>
          ))}
        </section>
      ))}
      {g.id === 'beber' && temAdicionais && (
        <section class="categoria" id="adicionais" aria-labelledby="titulo-adicionais" data-carta-secao>
          <header class="categoria__topo"><h2 id="titulo-adicionais">Adicionais</h2></header>
          <div class="adicionais">
            {cardapio.adicionaisBebidas.map((a: GrupoVista) => (
              <aside class="adicional" aria-label={a.nome}>
                <h3>{a.nome}</h3>
                <ul class="precos">
                  {a.itens.map((i) => <li data-item={i.id} data-preco={i.precoCentavos}><span class="precos__nome">{i.nome}</span><i aria-hidden="true"></i><span class="precos__valor">{i.preco}</span></li>)}
                </ul>
              </aside>
            ))}
          </div>
        </section>
      )}
    </div>
  ))}

  <footer class="carta__fim">
    <a class="btn btn--wine" href={PDF} target="_blank" rel="noopener">Abrir o PDF</a>
  </footer>

  <dialog class="produto-modal" aria-labelledby="produto-modal-nome" data-produto-modal>
    <div class="produto-modal__caixa">
      <button type="button" class="produto-modal__fechar" aria-label="Fechar" data-modal-fechar autofocus><span aria-hidden="true">×</span></button>
      <div class="produto-modal__foto" data-modal-foto hidden></div>
      <div class="produto-modal__texto">
        <h2 id="produto-modal-nome" data-modal-nome></h2>
        <p class="produto-modal__descricao" data-modal-descricao></p>
        <p class="produto-modal__preco" data-modal-preco></p>
      </div>
    </div>
  </dialog>
</main>

<script>
  import { initCartaNav } from '../scripts/cardapio-nav.js';
  import { initProdutoModal } from '../scripts/cardapio-modal.js';
  const nav = document.querySelector<HTMLElement>('[data-carta-nav]');
  if (nav) initCartaNav(nav);
  const carta = document.querySelector<HTMLElement>('.carta');
  if (carta) initProdutoModal(carta);
</script>
