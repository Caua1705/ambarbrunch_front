---
// 4 · MESA CHEIA — quadro de cortiça + cardápio em faixas (markup do v1).
// As fotos assentam como peças de colagem; as setas se desenham; parallax leve nas fotos.
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import Pendente from '../components/Pendente.astro';
import { cardapio, PARES } from '../data/cardapio';
const cor = (c: keyof typeof PARES) => { const p = PARES[c]; return `--b:${p.b}${'t' in p ? `;--t:${p.t}` : ''}`; };
---
<section class="mesa" id="gastronomia" aria-labelledby="mesa-titulo" tabindex="-1">
  <MegaTitle linhas={['Mesa', 'cheia']} id="mesa-titulo" scribble="do brunch ao café gelado" />

  <div class="board">
    <figure class="board__item board__item--a" data-reveal="piece" data-parallax="soft">
      <i class="tape" aria-hidden="true"></i>
      <Foto src="gastronomia/bruschetta-brunch.webp" alt="Torrada coberta vista de cima com xícara de café" sizes="(min-width: 960px) 431px, 61vw" />
    </figure>
    <figure class="board__item board__item--b" data-reveal="piece" data-parallax="up" style="--i:1">
      <i class="tape tape--r" aria-hidden="true"></i>
      <Foto src="gastronomia/croissant-prato-azul.webp" alt="Croissant em prato azul" sizes="(min-width: 960px) 353px, 50vw" />
    </figure>
    <figure class="board__item board__item--c" data-reveal="piece" data-parallax="soft" style="--i:2">
      <i class="tape" aria-hidden="true"></i>
      <Foto src="gastronomia/bebida-chocolate-creme.webp" alt="Bebida gelada de chocolate com calda" sizes="(min-width: 960px) 274px, 40vw" />
    </figure>

    <p class="note note--a">bruschettas<br />&amp; toasts</p>
    <svg class="arrow arrow--a" viewBox="0 0 120 80" aria-hidden="true" data-draw><path pathLength="1" d="M8 10C40 4 78 18 96 58" /><path pathLength="1" d="M84 52l13 8 3-15" /></svg>
    <p class="note note--b">croissant</p>
    <svg class="arrow arrow--b" viewBox="0 0 120 80" aria-hidden="true" data-draw style="--i:1"><path pathLength="1" d="M110 12C76 6 40 22 26 62" /><path pathLength="1" d="M20 48l5 15 14-6" /></svg>
    <p class="note note--c">bebidas<br />geladas</p>
    <svg class="arrow arrow--c" viewBox="0 0 120 80" aria-hidden="true" data-draw style="--i:2"><path pathLength="1" d="M112 70C86 74 58 60 46 18" /><path pathLength="1" d="M38 30l8-13 10 11" /></svg>
  </div>

  <div class="bands" data-reveal>
    <p class="bands__label">pra comer</p>
    <ul class="bands__list">{cardapio.comer.map((i) => <li style={cor(i.cor)}>{i.nome}</li>)}</ul>
    <p class="bands__label">pra beber</p>
    <ul class="bands__list">{cardapio.beber.map((i) => <li style={cor(i.cor)}>{i.nome}</li>)}</ul>
    <p class="bands__note">{cardapio.nota}</p>
    <Pendente falta="Itens do cardápio novo e fotos do shooting (21/10)" bloco class="mesa__pending" />
  </div>
</section>
