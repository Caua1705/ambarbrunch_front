---
// 3 · PARA SUA MESA — quadro de cortiça + cardápio em faixas (markup do v1).
// As fotos assentam como peças de colagem; as setas se desenham; parallax leve nas fotos.
// Cardápio tátil: cada etiqueta é um botão (indicador “+” que vira “×”) e abre um cartão de papel logo abaixo, com a foto
// principal da categoria (real ou ilustrativa, com selo), os itens do cardápio do cliente e, nos principais, miniaturas.
// O cartão dos rolls separa doces e salgados em abas e guarda os outros sabores num “ver mais” (lib/cardapio-tatil.js).
// Fotos dos cartões: lazy, só baixam quando o cartão abre.
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import Seta from '../components/Seta.astro';
import { cardapio, PARES, type Categoria, type FotoCardapio } from '../data/cardapio';
import { secoes } from '../data/secoes';
import { origemVisivel } from '../lib/conteudo';
import { imagem } from '../lib/media';
const cor = (c: keyof typeof PARES) => { const p = PARES[c]; return `--b:${p.b}${'t' in p ? `;--t:${p.t}` : ''}`; };
const grupos = [
  { id: 'comer', rotulo: 'pra comer', itens: cardapio.comer, offset: 0 },
  { id: 'beber', rotulo: 'pra beber', itens: cardapio.beber, offset: cardapio.comer.length },
];
const ok = (f?: FotoCardapio): f is FotoCardapio => !!f && origemVisivel(f.origem) && !!imagem(f.src);
const s = secoes.mesa;
---
<section class="mesa" id={s.id} aria-labelledby="mesa-titulo" tabindex="-1">
  <MegaTitle linhas={[...s.linhas]} id="mesa-titulo" scribble={s.sub} />

  <div class="board">
    <figure class="board__item board__item--a" data-reveal="piece" data-parallax="soft">
      <i class="tape" aria-hidden="true"></i>
      <Foto src="gastronomia/bruschetta-brunch.webp" alt="Torrada coberta vista de cima com xícara de café" sizes="(min-width: 960px) 431px, 61vw" />
    </figure>
    <figure class="board__item board__item--b" data-reveal="piece" data-parallax="up" style="--i:1">
      <i class="tape tape--r" aria-hidden="true"></i>
      <Foto src="gastronomia/croissant-prato-azul.webp" alt="Croissant em prato azul" sizes="(min-width: 960px) 353px, 50vw" />
    </figure>
    <figure class="board__item board__item--c" data-reveal="piece" data-parallax="soft" style="--i:2">
      <i class="tape" aria-hidden="true"></i>
      <Foto src="gastronomia/bebida-chocolate-creme.webp" alt="Bebida gelada de chocolate com calda" sizes="(min-width: 960px) 274px, 40vw" />
    </figure>

    <p class="note note--a">bruschettas<br />&amp; toasts</p>
    <Seta variante="a" />
    <p class="note note--b">croissant</p>
    <Seta variante="b" i={1} />
    <p class="note note--c">bebidas<br />geladas</p>
    <Seta variante="c" i={2} />
  </div>

  <div class="bands" data-reveal data-cardapio data-vivo>
    <p class="bands__hint"><span class="bands__dedo" aria-hidden="true">☝</span> toque numa etiqueta para abrir</p>
    {grupos.map((g) => (
      <>
        <p class="bands__label" id={`cardapio-${g.id}`}>{g.rotulo}</p>
        <ul class="bands__list" aria-labelledby={`cardapio-${g.id}`}>
          {g.itens.map((c, n) => (
            <li style={`${cor(c.cor)};--n:${n + g.offset}`}>
              <button type="button" class="bands__tap" aria-expanded="false" aria-controls={`painel-${g.id}`} data-categoria={c.id}>
                <span>{c.nome}</span><i class="bands__mais" aria-hidden="true"></i>
              </button>
            </li>
          ))}
        </ul>
        <div class="cartao" id={`painel-${g.id}`} data-painel hidden>
          <div class="cartao__dentro">
            {g.itens.map((c: Categoria) => {
              const d = c.detalhe;
              return (
                <article class="cartao__cat" data-cat={c.id} hidden aria-labelledby={`cat-${c.id}`}>
                  <header class:list={['cartao__head', !ok(d.foto) && 'cartao__head--sem-foto']}>
                    {ok(d.foto) && (
                      <figure class="cartao__prato">
                        <Foto src={d.foto.src} alt={d.foto.alt} sizes="(min-width: 960px) 132px, 104px" widths={[104, 208, 312]} qualidade={70} />
                        {d.foto.origem === 'ilustrativa' && <figcaption class="selo-ia">imagem ilustrativa</figcaption>}
                      </figure>
                    )}
                    <div class="cartao__titulo">
                      <h3 class="cartao__nome" id={`cat-${c.id}`}>{c.nome}</h3>
                      {d.linha && <p class="cartao__linha">{d.linha}</p>}
                    </div>
                    <button type="button" class="cartao__fechar" data-fechar aria-label={`Fechar ${c.nome}`}><span aria-hidden="true">×</span></button>
                  </header>

                  {d.abas && d.grupos.length > 1 && (
                    <div class="cartao__abas" role="tablist" aria-label={c.nome} data-abas hidden>
                      {d.grupos.map((gr, k) => (
                        <button type="button" role="tab" id={`aba-${c.id}-${gr.id}`} aria-controls={`grupo-${c.id}-${gr.id}`} aria-selected={k === 0 ? 'true' : 'false'} tabindex={k === 0 ? 0 : -1}>{gr.titulo}</button>
                      ))}
                    </div>
                  )}

                  {d.grupos.map((gr, k) => (
                    <div class="cartao__grupo" id={d.abas ? `grupo-${c.id}-${gr.id}` : undefined} role={d.abas ? 'tabpanel' : undefined}
                      aria-labelledby={d.abas ? `aba-${c.id}-${gr.id}` : undefined} data-aba={d.abas ? gr.id : undefined} data-primeira={d.abas && k === 0 ? '' : undefined}>
                      {gr.titulo && <p class="cartao__sub">{gr.titulo}</p>}
                      <ul class="cartao__itens">
                        {gr.itens.map((it, j) => (
                          <li class:list={[ok(it.foto) && 'cartao__item--foto']} style={`--k:${j}`}>
                            {ok(it.foto) && (
                              <span class="cartao__mini">
                                <Foto src={it.foto.src} alt="" sizes="48px" widths={[48, 96, 144]} qualidade={70} />
                                {it.foto.origem === 'ilustrativa' && <span class="visually-hidden"> (imagem ilustrativa)</span>}
                              </span>
                            )}
                            <strong>{it.nome}</strong>{it.desc && <span>{it.desc}</span>}
                          </li>
                        ))}
                      </ul>
                      {gr.mais && (
                        <details class="cartao__mais">
                          <summary>+ {gr.mais.itens.length} {gr.mais.rotulo}</summary>
                          <p>{gr.mais.itens.join(' · ')}</p>
                        </details>
                      )}
                      {gr.nota && <p class="cartao__nota">{gr.nota}</p>}
                    </div>
                  ))}
                  {d.nota && <p class="cartao__nota cartao__nota--so">{d.nota}</p>}
                  {d.ancora && <a class="cartao__link" href={d.ancora.href}>{d.ancora.texto} <span aria-hidden="true">↓</span></a>}
                </article>
              );
            })}
          </div>
        </div>
      </>
    ))}
    <p class="bands__note">{cardapio.nota}</p>
  </div>
</section>

<script>
  import { initCardapioTatil } from '../lib/cardapio-tatil.js';
  const raiz = document.querySelector<HTMLElement>('[data-cardapio]');
  if (raiz) initCardapioTatil(raiz);
</script>
