---
// 6 · CAFÉ E BEBIDAS (nova) — gelados autorais, matcha, lattes e clássicos. Sem preços.
// Composição viva (lib/bebidas.js): baralho de camadas — copos, combo e o cartão “cafés gelados” — que flutua de leve,
// acompanha o ponteiro pela profundidade (mouse) e traz para a frente a camada tocada. Movimento reduzido: baralho parado.
// Copos e combo são artes da proposta Âmbar × Roll (confirmado: false) → só na revisão; sem elas, fica o cartão.
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import { bebidas } from '../data/bebidas';
import { podeMostrar } from '../lib/conteudo';
import { imagem } from '../lib/media';

const camadas = bebidas.camadas.filter((c) => podeMostrar(c.confirmado) && imagem(c.src));
const total = camadas.length + 1;
---
<section class="bebidas" id="bebidas" aria-labelledby="bebidas-titulo" tabindex="-1">
  <svg class="bebidas__ramo" viewBox="0 0 300 300" aria-hidden="true" data-draw>
    <path pathLength="1" d="M45 269 C111 210 115 104 237 22" /><path pathLength="1" d="M91 219 C27 219 30 174 39 168 C77 170 90 190 91 219Z" /><path pathLength="1" d="M118 181 C158 178 184 148 179 123 C151 120 127 150 118 181Z" /><path pathLength="1" d="M133 154 C90 147 75 109 86 93 C113 101 136 127 133 154Z" /><path pathLength="1" d="M164 111 C198 112 226 91 223 63 C194 62 174 84 164 111Z" /><path pathLength="1" d="M195 79 C164 68 160 42 173 32 C194 45 199 63 195 79Z" />
  </svg>
  <div class="bebidas__head">
    <MegaTitle linhas={['Café', 'e bebidas']} id="bebidas-titulo" tom="wine" scribble="gelados autorais" />
    <p class="bebidas__lead" data-reveal>Gelados da casa, matcha, lattes e os clássicos do balcão, no copo Âmbar × Roll.</p>
    <ul class="bebidas__destaques" data-reveal>{bebidas.destaques.map((d, n) => <li style={`--n:${n}`}>{d}</li>)}</ul>
  </div>

  <div class:list={['baralho', total === 1 && 'baralho--so-cartao']} data-baralho data-vivo style={`--total:${total}`}>
    {camadas.map((c, i) => (
      <button type="button" class:list={['baralho__camada', 'baralho__foto', i === 1 && 'baralho__foto--recorte']} data-camada data-pos={i} style={`--ordem:${i}`} aria-label={`Trazer para a frente: ${c.alt}`}>
        <Foto src={c.src} alt={c.alt} sizes="(min-width: 960px) 360px, 70vw" widths={[360, 540, 720, 900]} qualidade={62} />
      </button>
    ))}
    <div class="baralho__camada baralho__cartao" data-camada data-pos={camadas.length} style={`--ordem:${camadas.length}`} tabindex="0" role="group" aria-label="Cafés gelados do cardápio">
      <p class="baralho__titulo">cafés gelados</p>
      <ul class="gelados">
        {bebidas.gelados.map((g) => <li style={`--tom:var(--${g.tom})`}><strong>{g.nome}</strong><span>{g.desc}</span></li>)}
      </ul>
      <p class="gelados__leite">leite: {bebidas.leites.join(' · ')}</p>
    </div>
  </div>
  {total > 1 && <p class="baralho__dica" aria-hidden="true">toque numa camada para trazer à frente</p>}

  <div class="bebidas__balcao" data-reveal>
    <p class="bands__label">também no balcão</p>
    <ul class="bebidas__classicos">{bebidas.classicos.map((c) => <li>{c}</li>)}</ul>
  </div>
</section>

<script>
  import { initBaralho } from '../lib/bebidas.js';
  const raiz = document.querySelector<HTMLElement>('[data-baralho]');
  if (raiz) initBaralho(raiz);
</script>
