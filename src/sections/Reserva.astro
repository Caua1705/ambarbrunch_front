---
// 9 · RESERVE SUA MESA — comanda (ilha Preact, carregada quando chega perto da tela).
// O modo vem do ambiente de build. Produção: PUBLIC_RESERVAS_MODO=api + PUBLIC_RESERVAS_API_URL — a API decide datas,
// horários e se as reservas estão abertas (fechadas, a comanda mostra um aviso discreto). Sem API configurada,
// “indisponível”: comanda ilustrativa, nada é coletado. Ver docs/technical/RESERVAS-LANCAMENTO.md.
import MegaTitle from '../components/MegaTitle.astro';
import ReservaFlow from '../islands/ReservaFlow';
import { reservaveis } from '../data/ambientes';
import { secoes } from '../data/secoes';

const modoEnv = import.meta.env.PUBLIC_RESERVAS_MODO;
const apiUrl = import.meta.env.PUBLIC_RESERVAS_API_URL || undefined;
const modo = modoEnv === 'simulado' ? 'simulado' : modoEnv === 'api' && apiUrl ? 'api' : 'indisponivel';
interface Props { titulo?: 'h1' | 'h2' }
const { titulo = 'h2' } = Astro.props;
const s = secoes.reserva;
---
<section class="reserva" id={s.id} aria-labelledby="reserva-titulo" data-reserva data-vivo tabindex="-1">
  <MegaTitle linhas={[...s.linhas]} id="reserva-titulo" tom="light" scribble={s.sub} as={titulo} />
  <ReservaFlow client:visible={{ rootMargin: '400px' }} modo={modo} apiUrl={apiUrl} ambientes={reservaveis.opcoes} privacidadeUrl="/privacidade/" />
</section>
