---
// 4 · DIRETO DA FORNADA — a Roll como assinatura gastronômica do Âmbar: a espiral de creme e caramelo (vídeo decorativo),
// um roll finalizado revelado em círculo, o processo em vídeo (da própria Roll, mudo), bandejas e os sabores que já
// passaram por aqui. Vídeos de criadores ficam em “Reações reais”. Não é vitrine: sem preço, sem compra, sem delivery.
// Imagens sem autorização (roll.fotos.*.autorizado = false) só aparecem no modo de revisão.
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import Badge from '../components/Badge.astro';
import Story from '../components/Story.astro';
import Spiral from '../components/Spiral.astro';
import Polvilho from '../components/Polvilho.astro';
import SeloFornada from '../components/SeloFornada.astro';
import { roll } from '../data/roll';
import { secoes } from '../data/secoes';
import { podeMostrar } from '../lib/conteudo';
import { imagem, video } from '../lib/media';
import { getImage } from 'astro:assets';

const s = secoes.fornada;
const videos = roll.videos.filter((v) => podeMostrar(v.autorizado) && video(v.arquivo));
const bandejas = podeMostrar(roll.bandejasAutorizadas) ? roll.bandejas.filter((b) => imagem(b.foto)) : [];
const anatomia = podeMostrar(roll.fotos.anatomia.autorizado) && imagem(roll.fotos.anatomia.foto) ? roll.fotos.anatomia : undefined;
// abertura: espiral (vídeo decorativo, volta ao início com esmaecimento). Capa responsiva; o 1º quadro vira o poster do <video>.
const espiral = roll.espiral;
const espiralSrc = video(espiral.arquivo);
const inicioMeta = imagem(espiral.inicio);
const inicioUrl = inicioMeta ? (await getImage({ src: inicioMeta, width: 450, format: 'webp', quality: 70 })).src : undefined;
---
<section class="roll" id={s.id} aria-labelledby="roll-titulo" tabindex="-1">
  <Spiral class="roll__spiral" />
  <Polvilho />

  <div class="roll__head">
    <MegaTitle linhas={[...s.linhas]} id="roll-titulo" tom="light" scribble={s.sub} />
    <p class="roll__lead" data-reveal>{roll.lead}</p>
  </div>

  <!-- Abertura: a espiral de creme, caramelo e canela numa janela em arco; um fio de caramelo sai dela, se desenha com a
       rolagem e leva até o roll finalizado logo abaixo (lib/espiral.js). -->
  {espiralSrc && (
    <div class="abertura" data-espiral data-vivo>
      <div class="abertura__lado">
        <Badge class="abertura__selo" />
        <p class="abertura__nota abertura__nota--a">creme,<br />caramelo<br /><em>&amp;</em> canela</p>
        <svg class="abertura__seta" viewBox="0 0 120 80" aria-hidden="true" data-draw><path pathLength="1" d="M8 18C40 8 78 14 104 46" /><path pathLength="1" d="M92 44l13 4 0-14" /></svg>
      </div>
      <figure class="abertura__painel">
        <div class="abertura__janela">
          <template data-video>
            <video class="abertura__video" muted playsinline preload="none" disablepictureinpicture poster={inicioUrl} aria-hidden="true" width="450" height="800">
              <source src={espiralSrc} type="video/mp4" />
            </video>
          </template>
          <Foto src={espiral.capa} alt={espiral.alt} class="abertura__capa" sizes="(min-width: 960px) 300px, 58vw" widths={[270, 400, 540]} qualidade={66} />
        </div>
      </figure>
      <p class="abertura__nota abertura__nota--b">…e vira roll<br />de verdade <span aria-hidden="true">↓</span></p>
      <svg class="abertura__fio" viewBox="0 0 390 150" preserveAspectRatio="none" aria-hidden="true"><path pathLength="1" d="M284 0C284 40 236 52 190 58C140 64 108 92 132 112C152 128 176 108 162 92C148 77 118 98 150 124C168 138 188 142 195 150" /></svg>
    </div>
  )}

  <!-- O roll finalizado: a espiral se desenha, a foto se revela num círculo que cresce do centro enquanto gira para o
       lugar (massa sendo enrolada) e as notas entram. Só CSS; a espiral ainda acompanha a rolagem onde houver suporte. -->
  {anatomia && (
    <figure class="anatomia" data-reveal="fade" data-vivo>
      <div class="anatomia__palco">
        <svg class="anatomia__espiral" viewBox="0 0 240 240" aria-hidden="true" data-draw><path pathLength="1" d="M121 219C56 218 19 164 28 103 40 31 127 2 182 51c34 30 31 82-9 105-37 21-80 2-83-30-4-30 26-46 47-33 13 7 15 27 2 35" /></svg>
        <div class="anatomia__foto"><Foto src={anatomia.foto} alt={anatomia.alt} sizes="(min-width: 960px) 340px, 62vw" widths={[300, 480, 680, 800]} qualidade={62} /></div>
        <SeloFornada class="anatomia__selo" />
        {roll.notas.map((n, i) => <p class:list={['anatomia__nota', `anatomia__nota--${'abc'[i]}`]} style={`--i:${i + 1}`}>{n}</p>)}
      </div>
    </figure>
  )}

  {videos.length > 0 && (
    <>
      <!-- Divisor = progresso do carrossel: o pontilhado é a trilha e um fio de caramelo a preenche conforme os vídeos
           deslizam (posição horizontal do carrossel, nunca o tempo do vídeo; lib/fita.js). Decorativo. -->
      <div class="roll__fita" aria-hidden="true" data-fita style={`--n:${videos.length}`}>
        <svg viewBox="0 0 240 240"><path d="M121 219C56 218 19 164 28 103 40 31 127 2 182 51c34 30 31 82-9 105-37 21-80 2-83-30-4-30 26-46 47-33 13 7 15 27 2 35" /></svg>
        <i class="roll__trilha"><b class="roll__fio"></b></i>
        <span>{String(videos.length).padStart(2, '0')}</span>
      </div>
      <ol class="stories" aria-label="Vídeos da Roll" data-fita-trilho>
        {videos.map((v) => <Story {...v} />)}
      </ol>
    </>
  )}

  {bandejas.length > 0 && (
    <div class="trays" data-reveal>
      {bandejas.map((b, i) => (
        <figure data-parallax={i === 1 ? 'up' : undefined}>
          <Foto src={b.foto} alt={b.alt} sizes="(min-width: 960px) 300px, 34vw" />
          <figcaption>{b.sabor}</figcaption>
        </figure>
      ))}
    </div>
  )}

  <div class="roll__sabores">
    <p class="roll__frase" data-reveal>{s.sabores}</p>
    <p class="bands__label">já passaram pela fornada</p>
    <ul class="sabores" aria-label="Sabores que já passaram pela fornada da Roll">
      {roll.sabores.map((sabor, n) => <li style={`--n:${n}`}>{sabor}</li>)}
    </ul>
  </div>
</section>

<script>
  import { initEspiral } from '../lib/espiral.js';
  import { initFita } from '../lib/fita.js';
  const raiz = document.querySelector<HTMLElement>('[data-espiral]');
  if (raiz) initEspiral(raiz);
  initFita(document.querySelector<HTMLElement>('[data-fita]'), document.querySelector<HTMLElement>('[data-fita-trilho]'));
</script>
