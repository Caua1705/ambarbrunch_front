---
// 5 · DIRETO DA FORNADA — a Roll como assinatura gastronômica do Âmbar: bastidores (vídeos da própria Roll, mudos),
// anatomia de um roll (composição editorial animada) e bandejas. Vídeos de criadores ficam em “Quem provou, conta”.
// Não é vitrine de loja: sem preço, sem compra, sem delivery. Mídia da Roll só com autorização (ou no modo de revisão).
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import Badge from '../components/Badge.astro';
import Story from '../components/Story.astro';
import Spiral from '../components/Spiral.astro';
import Pendente from '../components/Pendente.astro';
import { roll } from '../data/roll';
import { podeMostrar, isPendente, REVISAO } from '../lib/conteudo';
import { imagem, video } from '../lib/media';

const videos = roll.videos.filter((v) => podeMostrar(v.autorizado) && video(v.arquivo));
const bandejas = podeMostrar(roll.bandejasAutorizadas) ? roll.bandejas.filter((b) => imagem(b.foto)) : [];
const anatomia = podeMostrar(roll.fotos.anatomia.autorizado) && imagem(roll.fotos.anatomia.foto) ? roll.fotos.anatomia : undefined;
const pendentesAutorizacao = roll.videos.some((v) => !v.autorizado) || !roll.bandejasAutorizadas;
const doMes = roll.sabores.doMes;
---
<section class="roll" id="roll" aria-labelledby="roll-titulo" tabindex="-1">
  <Spiral class="roll__spiral" />

  <div class="roll__head">
    <Badge class="roll__badge" />
    <MegaTitle linhas={['Direto da', 'fornada']} id="roll-titulo" tom="light" />
    <p class="roll__lead" data-reveal>{roll.lead}</p>
  </div>

  <!-- Anatomia de um roll: a foto gira para o lugar como massa sendo enrolada, a espiral se desenha e as notas entram.
       Só CSS (transições do data-reveal + timeline de scroll onde houver suporte); nada em movimento reduzido. -->
  {anatomia && (
    <figure class="anatomia" data-reveal="fade">
      <div class="anatomia__palco">
        <svg class="anatomia__espiral" viewBox="0 0 240 240" aria-hidden="true" data-draw><path pathLength="1" d="M121 219C56 218 19 164 28 103 40 31 127 2 182 51c34 30 31 82-9 105-37 21-80 2-83-30-4-30 26-46 47-33 13 7 15 27 2 35" /></svg>
        <div class="anatomia__foto"><Foto src={anatomia.foto} alt={anatomia.alt} sizes="(min-width: 960px) 340px, 62vw" widths={[300, 480, 680]} qualidade={56} /></div>
        <p class="anatomia__nota anatomia__nota--a" style="--i:1">massa fresquinha</p>
        <p class="anatomia__nota anatomia__nota--b" style="--i:2">espiral de canela</p>
        <p class="anatomia__nota anatomia__nota--c" style="--i:3">direto da fornada</p>
      </div>
      {REVISAO && !roll.fotos.anatomia.autorizado && <Pendente falta={`Autorização da Roll para a foto ${roll.fotos.anatomia.id} (a de 17/10 cobriu IG-06/08/09)`} bloco class="anatomia__pendente" />}
    </figure>
  )}

  {videos.length > 0 && (
    <>
      <p class="roll__kicker">bastidores da Roll</p>
      <ol class="stories" aria-label="Vídeos da Roll">
        {videos.map((v) => <Story {...v} />)}
      </ol>
      <p class="roll__credit">Vídeos {[...new Set(videos.map((v) => v.autor))].join(' e ')} · {REVISAO && pendentesAutorizacao ? 'uso no site sujeito a autorização e sem trilha sonora' : 'sem trilha sonora'}</p>
    </>
  )}

  {bandejas.length > 0 && (
    <div class="trays" data-reveal>
      {bandejas.map((b, i) => (
        <figure data-parallax={i === 1 ? 'up' : undefined}>
          <Foto src={b.foto} alt={b.alt} sizes="(min-width: 960px) 300px, 34vw" />
          <figcaption>{b.sabor}</figcaption>
        </figure>
      ))}
    </div>
  )}

  <!-- Sabores só entram no site publicado quando o Âmbar/Roll confirmar quais estão disponíveis.
       Na revisão: os citados nas legendas da Roll, marcados como “a confirmar”. -->
  {(REVISAO || !isPendente(doMes)) && (
    <div class="roll__sabores">
      {REVISAO && <>
        <p class="bands__label">sabores citados pela Roll</p>
        <ul class="bands__list">{roll.sabores.fixos.map((s) => <li style="--b:var(--butter)">{s}</li>)}</ul>
        <Pendente falta="Quais sabores ficam fixos no Âmbar e quais são do mês" bloco class="roll__pending-sabores" />
      </>}
      {!isPendente(doMes) && <>
        <p class="bands__label">sabores do mês</p>
        <ul class="bands__list">{(doMes as string[]).map((s) => <li style="--b:var(--butter)">{s}</li>)}</ul>
      </>}
    </div>
  )}
  {REVISAO && pendentesAutorizacao && (
    <div class="roll__credit roll__pending"><Pendente falta="Autorização da Roll (fotos e vídeos do Instagram); sem ela, saem do site publicado" bloco /></div>
  )}

  <p class="roll__cta"><a href="#reservar">prove no Âmbar <strong>reservar →</strong></a></p>
</section>
