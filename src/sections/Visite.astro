---
// 10 · VISITE O ÂMBAR — onde fica e quando abre (dados oficiais, data/visita.ts). Sem mapa embutido (pesado e coleta
// dados): endereço em texto sobre um cartão desenhado (SVG leve) e o botão “Como chegar”, que abre o endereço real no app
// de mapas. Só o “como encontrar”: os contatos (WhatsApp e os dois Instagrams) ficam no rodapé, logo abaixo, sem repetir
// os mesmos botões (ajuste de 2026-10-18). Sem botão de reserva aqui: o botão fixo já faz esse papel.
import MegaTitle from '../components/MegaTitle.astro';
import SeloFornada from '../components/SeloFornada.astro';
import { visita as v } from '../data/visita';
import { secoes } from '../data/secoes';
const s = secoes.visite;
---
<section class="visite" id={s.id} aria-labelledby="visite-titulo" tabindex="-1" data-vivo>
  <MegaTitle linhas={[...s.linhas]} id="visite-titulo" tom="light" scribble={s.sub} />

  <div class="visite__grid">
    <article class="mapa" data-reveal="piece" aria-labelledby="mapa-endereco">
      <div class="mapa__desenho" aria-hidden="true">
        <svg viewBox="0 0 340 200" preserveAspectRatio="xMidYMid slice">
          <rect width="340" height="200" class="mapa__fundo" />
          <path class="mapa__quadra" d="M-10 30h96l14 52H-10zM120 -10h88l-10 70h-92zM228 -10h122v86H214zM-10 112h118l16 98H-10zM146 104h70l8 106h-92zM246 108h104v102H254z" />
          <path class="mapa__rua mapa__rua--larga" d="M-10 96C80 92 180 96 350 92" />
          <path class="mapa__rua" d="M112 -10L132 210M232 -10l10 220" />
          <path class="mapa__trajeto" d="M30 170C70 150 100 120 126 104S196 92 236 96" />
          <g class="mapa__pino" transform="translate(236 96)">
            <path d="M0 0C-12-16-18-24-18-33a18 18 0 0 1 36 0c0 9-6 17-18 33z" />
            <circle cy="-33" r="7" />
          </g>
        </svg>
        <span class="mapa__selo">Âmbar</span>
      </div>
      <div class="mapa__info">
        <p class="placa__kicker">Endereço</p>
        <p class="placa__addr" id="mapa-endereco">{v.endereco}</p>
        <p class="placa__city">{v.cidade}</p>
        <a class="btn btn--wine mapa__btn" href={v.mapaUrl} rel="noopener" target="_blank">Como chegar <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <div class="horarios" data-reveal="piece" style="--i:1">
      <div class="ticket">
        <p class="ticket__title">Horários</p>
        {v.horarios.map((h) => <p class="horarios__row"><span>{h.dias}</span><span>{h.horas}</span></p>)}
        <p class="horarios__extra">café, brunch e cinnamon rolls com assinatura da Roll</p>
      </div>
      <SeloFornada class="visite__selo" id="selo-visite" texto="aberto todos os dias · 07h às 19h · " />
    </div>
  </div>

</section>
