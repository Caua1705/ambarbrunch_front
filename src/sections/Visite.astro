---
// 9 · VISITE — onde fica e quando abre (dados oficiais, data/visita.ts). Sem mapa embutido: “Como chegar” abre o app de mapas.
import MegaTitle from '../components/MegaTitle.astro';
import SeloFornada from '../components/SeloFornada.astro';
import { visita as v } from '../data/visita';
import { roll } from '../data/roll';
---
<section class="visite" id="visite" aria-labelledby="visite-titulo" tabindex="-1" data-vivo>
  <MegaTitle linhas={['Visite', 'o Âmbar']} id="visite-titulo" tom="light" scribble="a mesa tá posta" />

  <div class="visite__grid">
    <div class="placa" data-reveal="piece" data-parallax="soft">
      <i class="placa__pin" aria-hidden="true"></i>
      <div class="label">
        <p class="placa__kicker">Endereço</p>
        <p class="placa__addr">{v.endereco}</p>
        <p class="placa__city">{v.cidade}</p>
      </div>
    </div>

    <div class="horarios" data-reveal="piece" style="--i:1">
      <div class="ticket">
        <p class="ticket__title">Horários</p>
        {v.horarios.map((h) => <p class="horarios__row"><span>{h.dias}</span><span>{h.horas}</span></p>)}
        <p class="horarios__extra">café, brunch e cinnamon rolls com assinatura da Roll</p>
      </div>
      <SeloFornada class="visite__selo" id="selo-visite" texto="aberto todos os dias · 07h às 19h · " />
    </div>
  </div>

  <div class="visite__actions">
    <a class="btn btn--butter" href="#reservar">Reservar mesa <span aria-hidden="true">→</span></a>
    <div class="visite__links">
      <a class="pill-link" href={v.mapaUrl} rel="noopener" target="_blank">Como chegar ↗</a>
      <a class="pill-link" href={v.whatsapp.url} rel="noopener" target="_blank">WhatsApp {v.whatsapp.numero}</a>
      <a class="pill-link" href={v.instagram.url} rel="noopener">{v.instagram.handle}</a>
      <a class="pill-link" href={roll.instagram.url} rel="noopener">Roll {roll.instagram.handle}</a>
    </div>
  </div>
</section>
