---
// 9 · VISITE (nova). Onde fica e quando abre. TODOS os dados estão pendentes: nada é inventado.
// Sem mapa embutido: “Como chegar” abre o app de mapas.
import MegaTitle from '../components/MegaTitle.astro';
import Pendente from '../components/Pendente.astro';
import { visita as v } from '../data/visita';
import { roll } from '../data/roll';
import { isPendente, REVISAO } from '../lib/conteudo';

const horarios = isPendente(v.horarios) ? null : v.horarios;
const mapa = isPendente(v.mapaUrl) ? null : v.mapaUrl;
const wa = isPendente(v.whatsapp) ? null : v.whatsapp;
const ig = isPendente(v.instagram) ? null : v.instagram;
// sem endereço nem horários (no site publicado): um aviso honesto no lugar da placa e da comanda vazias
const temDados = !isPendente(v.endereco) || !!horarios;
---
<section class="visite" id="visite" aria-labelledby="visite-titulo" tabindex="-1">
  <MegaTitle linhas={['Visite', 'o Âmbar']} id="visite-titulo" tom="light" />

  <div class="visite__grid">
    {!temDados && !REVISAO && (
      <div class="horarios" data-reveal="piece">
        <div class="ticket">
          <p class="ticket__title">Em breve</p>
          <p class="ticket__slots">Endereço e horários serão publicados aqui. Até lá, as novidades saem no Instagram da Roll.</p>
        </div>
      </div>
    )}
    {(temDados || REVISAO) && <>
    <div class="placa" data-reveal="piece" data-parallax="soft">
      <i class="placa__pin" aria-hidden="true"></i>
      <div class="label">
        <p class="placa__kicker">Endereço</p>
        {isPendente(v.endereco) ? <Pendente falta={v.endereco.falta} /> : <p class="placa__addr">{v.endereco}</p>}
        {isPendente(v.cidade) ? <Pendente falta={v.cidade.falta} /> : <p class="placa__city">{v.cidade}</p>}
      </div>
    </div>

    <div class="horarios" data-reveal="piece" style="--i:1">
      <div class="ticket">
        <p class="ticket__title">Horários</p>
        {horarios
          ? horarios.map((h) => <p class="horarios__row"><span>{h.dias}</span><span>{h.horas}</span></p>)
          : <Pendente falta={(v.horarios as { falta: string }).falta} bloco />}
        {isPendente(v.extras) && <Pendente falta={v.extras.falta} bloco />}
      </div>
    </div>
    </>}
  </div>

  <div class="visite__actions">
    <a class="btn btn--butter" href="#reservar">Reservar mesa <span aria-hidden="true">→</span></a>
    <div class="visite__links">
      {mapa
        ? <a class="pill-link" href={mapa} rel="noopener" target="_blank">Como chegar ↗</a>
        : <span class="pill-link" aria-disabled="true">Como chegar · em breve</span>}
      {wa && <a class="pill-link" href={wa.url} rel="noopener">WhatsApp</a>}
      {ig && <a class="pill-link" href={ig.url} rel="noopener">{ig.handle}</a>}
      <a class="pill-link" href={roll.instagram.url} rel="noopener">Roll {roll.instagram.handle}</a>
    </div>
    {(!wa || !ig) && <Pendente falta="WhatsApp e Instagram do Âmbar" />}
  </div>
</section>
