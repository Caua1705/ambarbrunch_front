---
// 6 · SALADAS & BOWLS — pratos do menu saudável, um de cada vez (abas com miniatura): foto num prato de papel com
// marcadores de ingrediente, texto curto, ingredientes e a ficha nutricional em rótulo (tabela com barras, porção,
// alergênicos), recolhida: abre e fecha com animação ao tocar no título. Sem JS, pratos e ficha ficam abertos, um embaixo
// do outro. Site publicado: alergênicos e ficha só quando validados (data/prato.ts); até lá, “em validação”.
// Modo de revisão: os números de EXEMPLO aparecem sem selo visual (data-provisoria). Nenhuma alegação de saúde ou de calorias.
import Foto from '../components/Foto.astro';
import MegaTitle from '../components/MegaTitle.astro';
import { pratos, camposFicha, fichaEmValidacao, type Ficha } from '../data/prato';
import { secoes } from '../data/secoes';
import { REVISAO, isPendente, origemVisivel } from '../lib/conteudo';
import { imagem } from '../lib/media';

const s = secoes.saladas;
const lista = pratos.filter((p) => origemVisivel(p.foto.origem) && imagem(p.foto.src));
const fichaDe = (p: (typeof pratos)[number]): { ficha: Ficha; demo: boolean } | undefined =>
  !isPendente(p.ficha) ? { ficha: p.ficha, demo: false } : REVISAO && p.fichaDemo ? { ficha: p.fichaDemo, demo: true } : undefined;
---
{lista.length > 0 && (
  <section class="prato" id={s.id} aria-labelledby="prato-titulo" tabindex="-1" data-pratos data-antecipar>
    <MegaTitle linhas={[...s.linhas]} id="prato-titulo" tom="wine" scribble={s.sub} />

    {lista.length > 1 && (
      <div class="pratos__abas" role="tablist" aria-label="Pratos" data-abas hidden>
        {lista.map((p, i) => (
          <button type="button" role="tab" id={`aba-${p.id}`} aria-controls={`prato-${p.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="pratos__mini"><Foto src={p.foto.src} alt="" sizes="44px" widths={[44, 88, 132]} qualidade={70} /></span>
            <span><small>{p.linha}</small>{p.nome}</span>
          </button>
        ))}
      </div>
    )}

    {lista.map((p) => {
      const f = fichaDe(p);
      return (
        <article class="prato__grid" id={`prato-${p.id}`} role={lista.length > 1 ? 'tabpanel' : undefined} aria-labelledby={lista.length > 1 ? `aba-${p.id}` : `nome-${p.id}`} data-prato>
          <figure class="prato__foto" data-reveal="fade">
            <i class="prato__fundo" aria-hidden="true"></i>
            <div class="prato__tigela" data-parallax="soft"><Foto src={p.foto.src} alt={p.foto.alt} sizes="(min-width: 960px) 400px, 76vw" widths={[300, 400, 540, 800]} qualidade={70} /></div>
            {p.marcadores.map((m, i) => (
              <span class="prato__pino" style={`--x:${m.x}%;--y:${m.y}%;--i:${i}`} aria-hidden="true"><i></i>{m.nome}</span>
            ))}
          </figure>

          <div class="prato__card" data-reveal>
            <p class="prato__kicker">{p.linha}</p>
            <h3 class="prato__nome" id={`nome-${p.id}`}>{p.nome}</h3>
            <p class="prato__texto">{p.texto}</p>
            <ul class="prato__ingredientes" aria-label="Ingredientes">{p.ingredientes.map((i) => <li>{i}</li>)}</ul>

            {/* ficha no formato de rótulo, recolhida: o título é o botão que abre e fecha (suave, nos dois sentidos).
                Sem ficha validada, as linhas dizem “em validação” no lugar do número. Na revisão, os números provisórios
                aparecem sem selo na tela (marcados só em data-provisoria e no texto para leitor de tela); no site
                publicado nunca entram. Comentário de template: não vai para o HTML. */}
            <section class="ficha" aria-labelledby={`ficha-${p.id}`} data-ficha data-provisoria={f?.demo ? '' : undefined}>
              <h4 class="ficha__nome" id={`ficha-${p.id}`}>
                <button type="button" class="ficha__topo" aria-expanded="false" aria-controls={`ficha-corpo-${p.id}`} data-ficha-botao>
                  <span>Informação nutricional</span>
                  <i class="ficha__mais" aria-hidden="true"></i>
                </button>
              </h4>
              <div class="ficha__corpo" id={`ficha-corpo-${p.id}`}>
                <div class="ficha__dentro">
                  <p class="ficha__porcao">{f ? `porção de ${f.ficha.porcao}` : 'porção · em validação'}</p>
                  <table class="ficha__tabela">
                    <caption class="visually-hidden">Informação nutricional{f ? ` por porção de ${f.ficha.porcao}` : ''}{f?.demo ? ' (valores provisórios, ainda não validados)' : f ? '' : ' (valores em validação)'}</caption>
                    <tbody>
                      {(f ? f.ficha.valores : camposFicha).map((n, i) => {
                        const valor = 'valor' in n ? n.valor : undefined;
                        return (
                          <tr style={`--v:${valor === undefined ? 0 : Math.min(1, valor / n.max)};--i:${i}`}>
                            <th scope="row">{n.rotulo}</th>
                            <td><span class="ficha__valor">
                              <span class="ficha__barra" aria-hidden="true"><i></i></span>
                              {valor === undefined ? <em>em validação</em> : <strong>{valor.toLocaleString('pt-BR')} {n.unidade}</strong>}
                            </span></td>
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>

                  <p class="ficha__titulo">Alergênicos</p>
                  {isPendente(p.alergenicos)
                    ? <p class="ficha__texto ficha__texto--aviso">{fichaEmValidacao}</p>
                    : <ul class="ficha__alergenicos">{p.alergenicos.map((a) => <li>{a}</li>)}</ul>}
                </div>
              </div>
            </section>
          </div>
        </article>
      );
    })}
  </section>
)}

<script>
  // abas dos pratos (padrão WAI-ARIA): sem JS, os pratos ficam um embaixo do outro
  const raiz = document.querySelector<HTMLElement>('[data-pratos]');
  // ficha nutricional: o título abre e fecha (a animação é CSS, em prato.css e motion.css)
  raiz?.querySelectorAll<HTMLButtonElement>('[data-ficha-botao]').forEach((b) => {
    const ficha = b.closest<HTMLElement>('[data-ficha]');
    b.addEventListener('click', () => {
      const abrir = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(abrir));
      ficha?.toggleAttribute('data-aberta', abrir);
    });
  });
  const lista = raiz?.querySelector<HTMLElement>('[data-abas]');
  if (raiz && lista) {
    const abas = [...lista.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const escolher = (aba: HTMLButtonElement, focar = false) => {
      abas.forEach((t) => {
        const sel = t === aba;
        t.setAttribute('aria-selected', String(sel));
        t.tabIndex = sel ? 0 : -1;
        const painel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (painel) { painel.hidden = !sel; if (sel) painel.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in')); }
      });
      if (focar) aba.focus();
    };
    lista.hidden = false;
    escolher(abas[0]);
    abas.forEach((a, i) => {
      a.addEventListener('click', () => escolher(a));
      a.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : null;
        if (n === null) return;
        e.preventDefault();
        escolher(abas[(n + abas.length) % abas.length], true);
      });
    });
  }
</script>
