---
// 7 · QUEM PROVOU, CONTA — vídeos de criadores sobre a Roll, num carrossel com o card ativo no centro e os vizinhos
// aparecendo nas bordas. Swipe = scroll-snap nativo; setas e contador seguem o card ativo (lib/carrossel.js).
// No máximo dois vídeos tocam juntos, sempre mudos; o som é por card, um de cada vez, só depois do toque do visitante.
// Cards limpos: sem @ ou descrição sobrepostos pelo site (o que o criador gravou no vídeo fica). Áudio original preservado.
// No site publicado só entram vídeos com autorização do criador.
import MegaTitle from '../components/MegaTitle.astro';
import Story from '../components/Story.astro';
import Spiral from '../components/Spiral.astro';
import { criadores } from '../data/criadores';
import { secoes } from '../data/secoes';
import { podeMostrar } from '../lib/conteudo';
import { video } from '../lib/media';

const s = secoes.provou;
const videos = criadores.videos.filter((v) => podeMostrar(v.autorizado) && video(v.arquivo));
---
{videos.length > 0 && (
  <section class="provou" id={s.id} aria-labelledby="provou-titulo" tabindex="-1" data-provou>
    <Spiral class="provou__spiral" />
    <div class="provou__head">
      <MegaTitle linhas={[...s.linhas]} direita={[...s.direita]} id="provou-titulo" tom="light" />
      <p class="provou__lead" data-reveal><strong>{s.sub}</strong></p>
    </div>

    <div class="provou__palco">
      <ol class="stories stories--provou" data-trilho aria-label="Vídeos de quem provou a Roll" data-unico={videos.length === 1 ? '' : undefined}>
        {videos.map((v) => <Story {...v} tipo="criador" carrossel />)}
      </ol>
      {videos.length > 1 && (
        <div class="provou__setas">
          <button class="provou__seta" type="button" data-prev aria-label="Vídeo anterior" disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg></button>
          <p class="provou__contador"><span data-contador>01</span><i aria-hidden="true"> / </i><span class="visually-hidden"> de </span>{String(videos.length).padStart(2, '0')}</p>
          <button class="provou__seta" type="button" data-next aria-label="Próximo vídeo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg></button>
        </div>
      )}
    </div>
  </section>
)}

<script>
  import { initCarrossel } from '../lib/carrossel.js';
  const raiz = document.querySelector<HTMLElement>('[data-provou]');
  if (raiz) initCarrossel(raiz);
</script>
