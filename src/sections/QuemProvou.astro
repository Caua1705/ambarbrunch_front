---
// 7 · REAÇÕES REAIS (título definitivo de 2026-10-18; antes “Provou, conta”) — vídeos de criadores sobre a Roll num
// carrossel vivo (referência Zuzzi): três à vista — o central inteiro e em destaque, os vizinhos cortados pelas bordas —
// e OS TRÊS em movimento ao mesmo tempo. Começa mudo; depois do 1º toque no som, a voz acompanha o card central a cada
// troca (só ele fala). Em laço: sempre há um vizinho de cada lado, sem ponta vazia. Arraste e pontos (lib/carrossel.js).
// Cards limpos: sem @, sem descrição, sem legenda/transcrição. Áudio original preservado, liberado pelo botão de som.
// No site publicado só entram vídeos com autorização do criador.
import MegaTitle from '../components/MegaTitle.astro';
import Story from '../components/Story.astro';
import Spiral from '../components/Spiral.astro';
import { criadores } from '../data/criadores';
import { secoes } from '../data/secoes';
import { podeMostrar } from '../lib/conteudo';
import { video } from '../lib/media';

const s = secoes.provou;
const videos = criadores.videos.filter((v) => podeMostrar(v.autorizado) && video(v.arquivo));
// abre no 2º card (com 3+ vídeos); lugar de cada card no laço: 0 = central, ±1 = vizinhos, ±2 = fora da tela
const inicial = videos.length >= 3 ? 1 : 0;
const lugar = (i: number) => { const n = videos.length; const d = (((i - inicial) % n) + n) % n; return d > n / 2 ? d - n : d; };
---
{videos.length > 0 && (
  <section class="provou" id={s.id} aria-labelledby="provou-titulo" tabindex="-1" data-provou>
    <Spiral class="provou__spiral" />
    <div class="provou__head">
      <MegaTitle linhas={[...s.linhas]} id="provou-titulo" tom="light" />
      <p class="provou__lead" data-reveal>{s.sub}</p>
    </div>

    <div class="provou__palco">
      <ol class="stories stories--provou" data-trilho data-inicial={inicial} aria-label="Vídeos de quem provou a Roll" aria-roledescription="carrossel" data-unico={videos.length === 1 ? '' : undefined}>
        {videos.map((v, i) => <Story {...v} tipo="criador" carrossel pos={lugar(i)} />)}
      </ol>
      {videos.length > 1 && (
        <div class="provou__pontos" data-pontos role="group" aria-label="Escolher vídeo">
          {videos.map((_, i) => (
            <button class="provou__ponto" type="button" data-ponto aria-current={i === inicial ? 'true' : 'false'} aria-label={`Vídeo ${i + 1} de ${videos.length}`}><i aria-hidden="true"></i></button>
          ))}
        </div>
      )}
    </div>
  </section>
)}

<script>
  import { initCarrossel } from '../lib/carrossel.js';
  const raiz = document.querySelector<HTMLElement>('[data-provou]');
  if (raiz) initCarrossel(raiz);
</script>
