---
// 1 · HERO · Fornada Âmbar — markup do v1 (concept-b-aprovado-v1) + selo do menu.
// O título é o maior texto da 1ª tela (LCP): visível desde o 1º quadro. A colagem encolhe pela altura em telas baixas.
// As três peças contam o título: o roll da Roll em destaque (círculo, close do roll Kinder), o lugar (salão principal)
// e o brunch com café (ladrilho), costurados pelo selo da Roll.
// Entrada cinematográfica em motion.css §2 (etiqueta encaixa → palavras → recortes → carimbo da Roll → CTA).
import Foto from '../components/Foto.astro';
import MenuButton from '../components/MenuButton.astro';
import StickerRoll from '../components/StickerRoll.astro';
import Faiscas from '../components/Faiscas.astro';
import Ticker from '../components/Ticker.astro';
import { ambientes } from '../data/ambientes';
import { cardapio } from '../data/cardapio';
import { visita } from '../data/visita';
import { roll } from '../data/roll';
import { secoes } from '../data/secoes';
import { podeMostrar } from '../lib/conteudo';
import { imagem } from '../lib/media';

const fotoRoll = podeMostrar(roll.fotos.hero.autorizado) && imagem(roll.fotos.hero.foto) ? roll.fotos.hero : undefined;
const circulo = fotoRoll ?? { foto: 'gastronomia/croissant-prato-azul.webp', alt: 'Croissant em prato azul sobre sofá laranja' };
const [l1, l2, l3] = secoes.hero.linhas;
---
<header class="hero" id="topo" data-hero data-vivo>
  <MenuButton variante="hero" />
  <div class="hero__label">
    <h1 class="label">
      <Foto src="brand/logo-ambar.png" alt="Âmbar Brunch — logo âmbar café & brunch" sizes="(min-width: 960px) 312px, 64vw" widths={[250, 330, 500, 750]} prioridade qualidade={82} />
    </h1>
  </div>

  <p class="hero__headline">
    <span class="l1">{l1}</span>
    <span class="l2">{l2}</span>
    <span class="l3"><em>&amp;</em> {l3.replace('& ', '')}</span>
  </p>

  <div class="hero__collage" data-parallax="hero-exit">
    <figure class:list={["cut cut--circle", fotoRoll && "cut--roll"]}>
      <Foto src={circulo.foto} alt={circulo.alt} sizes="(min-width: 960px) 26vw, 46vw" widths={[200, 300, 400, 450]} eager qualidade={60} />
    </figure>
    <figure class="cut cut--polaroid" data-float>
      <Foto src={ambientes.salao.foto} alt={ambientes.salao.alt} sizes="(min-width: 960px) 20vw, 36vw" widths={[160, 240, 360, 480]} eager />
    </figure>
    <!-- a 3ª foto desce com a rolagem durante TODA a saída do hero (lib/motion.js → initHeroDescida) -->
    <figure class="cut cut--tile" data-float="b" data-desce>
      <Foto src="gastronomia/bruschetta-brunch.webp" alt="Torrada coberta vista de cima, com xícara de café ao lado" sizes="(min-width: 960px) 15vw, 27vw" widths={[120, 180, 270, 360]} eager />
    </figure>
    <StickerRoll />
    <Faiscas />
    {fotoRoll && <p class="hero__anota" aria-hidden="true">quentinho<br />da fornada</p>}
  </div>

  <div class="hero__foot">
    <a class="btn btn--butter" href="#reservar" data-cta-trigger>Reservar mesa <span aria-hidden="true">→</span></a>
    <p class="hero__note">{visita.horarios[0].dias}<br />{visita.horarios[0].horas}</p>
  </div>
</header>

<!-- Faixa de categorias (costura o hero à seção seguinte) -->
<Ticker itens={cardapio.faixa} />
