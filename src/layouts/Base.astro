---
// Layout base: <head>, fontes auto-hospedadas, skip link, doca (menu + CTA fixo), folha do menu e scripts.
import '../styles/index.css';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import fraunces from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-italic.woff2?url';
import Dock from '../components/Dock.astro';
import NavSheet from '../components/NavSheet.astro';
import Medicao from '../components/Medicao.astro';
import { REVISAO } from '../lib/conteudo';
import { imagensSeo, seo, SITE } from '../data/seo';
import { GSC_VERIFICACAO, MEDICAO_LIGADA, paginaMedida } from '../lib/medicao-config';

interface Props {
  titulo?: string;
  descricao?: string;
  indexar?: boolean;
  /** Na home as âncoras são locais; nas páginas internas apontam para a home. */
  home?: boolean;
  /** Página só com o próprio conteúdo (confirmação da reserva): sem “pular para a reserva”, barra de progresso, botão
   *  fixo “Reservar mesa” nem menu. */
  enxuta?: boolean;
}
const {
  titulo = seo.titulo,
  descricao = seo.descricao,
  indexar = !REVISAO,
  home = true,
  enxuta = false,
} = Astro.props;
// SEO (2026-10-30): endereço canônico sempre no domínio oficial — o mesmo HTML também responde em *.vercel.app, e o
// Google deve contar só o ambarbrunch.com. Imagem de compartilhamento: o salão principal, 1200 × 630.
const canonico = new URL(Astro.url.pathname, SITE).href;
const { capa } = await imagensSeo();
const medir = MEDICAO_LIGADA && paginaMedida(Astro.url.pathname);
// Faixa Latin (português incluso), igual ao subconjunto do Google Fonts usado no protótipo.
const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const fontes = `
@font-face{font-family:"Bricolage Grotesque";font-style:normal;font-display:swap;font-weight:200 800;font-stretch:75% 100%;src:url(${bricolage}) format("woff2");unicode-range:${LATIN}}
@font-face{font-family:"Fraunces";font-style:italic;font-display:swap;font-weight:100 900;src:url(${fraunces}) format("woff2");unicode-range:${LATIN}}
@font-face{font-family:"Bricolage Fallback";src:local("Arial"),local("ArialMT"),local("Roboto"),local("Helvetica");size-adjust:90.9%;ascent-override:102.3%;descent-override:29.7%;line-gap-override:0%;unicode-range:${LATIN}}
@font-face{font-family:"Fraunces Fallback";font-style:italic;src:local("Georgia Italic"),local("Georgia-Italic"),local("Georgia");size-adjust:85.1%;ascent-override:115.2%;descent-override:30.6%;line-gap-override:0%;unicode-range:${LATIN}}`;
// Fontes de reserva (auditoria I-20): Arial/Roboto e Georgia com as métricas da Bricolage e da Fraunces (medidas no navegador:
// largura média de um texto do site, ascendente e descendente). Antes das fontes carregarem, o texto ocupa o mesmo espaço.
// Mesmo unicode-range das fontes reais: glifos fora dele (→, ✺) continuam na cadeia de antes.
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo}</title>
  <meta name="description" content={descricao} />
  {!indexar && <meta name="robots" content="noindex" />}
  {indexar && <link rel="canonical" href={canonico} />}
  {GSC_VERIFICACAO && <meta name="google-site-verification" content={GSC_VERIFICACAO} />}
  <meta name="theme-color" content="#670D27" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={seo.nome} />
  <meta property="og:url" content={canonico} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descricao} />
  <meta property="og:locale" content="pt_BR" />
  {capa && <meta property="og:image" content={capa} />}
  {capa && <meta property="og:image:width" content="1200" />}
  {capa && <meta property="og:image:height" content="630" />}
  {capa && <meta property="og:image:alt" content="Salão do Âmbar, com paredes cor de âmbar e luminárias acesas" />}
  <meta name="twitter:card" content={capa ? 'summary_large_image' : 'summary'} />
  {medir && <Medicao />}
  <!-- ícone oficial: o logo do Âmbar Brunch sobre creme -->
  <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
  <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
  <!-- a Fraunces também é pré-carregada: o “&” do título usa essa fonte, e a troca tardia empurrava a colagem (CLS) -->
  <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
  <style set:html={fontes}></style>
  <!-- Entrada do hero em TODO carregamento (F5 incluso): o recarregamento volta ao topo e tira a âncora que um clique
       anterior deixou na URL (antes, “#reservar” ou a rolagem restaurada desligavam a cena). Link direto para uma seção
       continua indo até ela. A classe sai sozinha ao fim da cena (lib/motion.js), então rolar de volta não repete. -->
  <script is:inline>(function(d){d.classList.add('js');try{history.scrollRestoration='manual';var n=performance.getEntriesByType('navigation')[0];if(n&&n.type==='reload'&&location.hash)history.replaceState(history.state,'',location.pathname+location.search);}catch(e){}if(!matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('enter');})(document.documentElement);</script>
  <!-- extras de uma página no <head> (ex.: /clube/ativar: referrer e captura do link antes de qualquer pintura) -->
  <slot name="head" />
</head>
<body>
  {!enxuta && <a class="skip-link" href={home ? '#reservar' : '/#reservar'}>Pular para a reserva</a>}
  {!enxuta && <div class="progresso" aria-hidden="true"></div>}
  <slot />
  {!enxuta && <Dock href={home ? '#reservar' : '/#reservar'} />}
  {!enxuta && <NavSheet base={home ? '' : '/'} />}
  <script>import '../lib/site.js';</script>
</body>
</html>
