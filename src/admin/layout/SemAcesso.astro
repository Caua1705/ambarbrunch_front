---
// Módulo que o papel não pode ver (o backend também recusa: 403) ou que ainda não foi liberado neste ambiente
// (PAINEL_MODULOS). Sem dados, sem detalhes.
import { Lock, Clock } from 'lucide-preact';

interface Props {
  naoLiberado?: boolean;
}
const { naoLiberado = false } = Astro.props;
---

<div class="cartao">
  <div class="estado">
    {naoLiberado ? (
      <>
        <span class="estado__icone"><Clock aria-hidden="true" /></span>
        <h3>Este módulo ainda não foi liberado</h3>
        <p>A equipe vai usar esta área quando ela for liberada no painel. Por enquanto, siga pelas áreas do menu.</p>
      </>
    ) : (
      <>
        <span class="estado__icone"><Lock aria-hidden="true" /></span>
        <h3>Sem acesso a esta área</h3>
        <p>Seu perfil não tem permissão para abrir este módulo. Se você precisa dele no seu trabalho, fale com o administrador.</p>
      </>
    )}
    <a class="btn btn--p" href="/admin">Voltar ao início</a>
  </div>
</div>
