---
// Visão Geral — sessão conferida no middleware; o módulo só aparece para quem tem o papel (o backend confere de novo).
import Painel from '../layout/Painel.astro';
import SemAcesso from '../layout/SemAcesso.astro';
import VisaoGeral from '../modulos/visao-geral';
import { podeVer } from '../lib/permissoes';

export const prerender = false;
const contexto = Astro.locals.painel;
if (!contexto) return Astro.redirect('/admin/login', 303);
// Liberação controlada (PAINEL_MODULOS) e papel, os dois conferidos aqui no servidor.
const liberado = contexto.modulos.includes('visao-geral');
if (!liberado && contexto.modulos.includes('reservas')) return Astro.redirect('/admin/reservas', 303);
const pode = liberado && podeVer(contexto.usuario.papel, 'visao-geral');
---

<Painel titulo="Visão Geral" modulo="visao-geral" contexto={contexto}>
  {pode ? (
    <VisaoGeral client:only="preact" contexto={contexto}>
      <div slot="fallback" class="carregando-modulo" aria-busy="true" aria-label="Carregando"><span class="esqueleto" style="height:28px;width:40%"></span><span class="esqueleto" style="height:110px"></span><span class="esqueleto" style="height:320px"></span></div>
    </VisaoGeral>
  ) : (
    <SemAcesso naoLiberado={!liberado} />
  )}
</Painel>
