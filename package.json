{
  "name": "ambarbrunch-front",
  "private": true,
  "version": "0.1.0",
  "description": "Site de reservas do Âmbar Brunch — Conceito B · Fornada Âmbar",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clube": "astro dev --open /clube/",
    "build": "astro build",
    "build:revisao": "astro build --mode revisao",
    "build:simulado": "astro build --mode simulado --outDir dist-sim",
    "preview": "astro preview",
    "check": "astro check",
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:video": "node scripts/encode-video.mjs",
    "media:influenciadores": "node scripts/encode-influenciadores.mjs",
    "media:kit": "node scripts/importar-kit-v2.mjs",
    "test": "playwright test",
    "test:fidelity": "playwright test --project=fidelity",
    "test:e2e": "playwright test --project=chromium --project=webkit",
    "shots": "node scripts/shots.mjs",
    "perf": "node scripts/lighthouse.mjs",
    "painel:demo": "node scripts/painel.mjs demo",
    "painel:dev": "node scripts/painel.mjs dev",
    "painel:build": "node scripts/painel.mjs build",
    "painel:serve": "node scripts/painel.mjs serve"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@astrojs/preact": "6.1.0",
    "@astrojs/vercel": "11.0.17",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "astro": "7.4.0",
    "lucide-preact": "1.63.0",
    "preact": "11.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "lighthouse": "13.5.0",
    "typescript": "6.0.3"
  }
}
