# Copie para .env.local (ignorado pelo Git). Nenhum segredo vai para o frontend.
# Modo de revisão local: mostra conteúdo pendente marcado e mídia com autorização pendente.
PUBLIC_REVISAO=1
# indisponivel (padrão) | simulado (testes, com aviso visível) | api (somente após validar o contrato)
PUBLIC_RESERVAS_MODO=indisponivel
# URL de STAGING da API FastAPI (preencher só depois do contrato validado)
PUBLIC_RESERVAS_API_URL=
# Clube Âmbar: indisponivel (padrão: bilhete “em breve”, nada é pedido) | api (com a API do Clube) | simulado (só no
# `astro dev`: API de mentira para testar a entrada pelo WhatsApp; nenhum build usa).
PUBLIC_CLUBE_MODO=simulado
# URL base da API do Clube. A sessão é um cookie: o Clube só funciona com o site em https://ambarbrunch.com e a API em
# https://api.ambarbrunch.com (mesmo site). Em *.vercel.app o cookie é bloqueado.
PUBLIC_CLUBE_API_URL=
# Clube na home e no menu: desligado (padrão) até o lançamento do Clube | 1 (mostra o convite da home e o item do menu)
PUBLIC_CLUBE_HOME=
