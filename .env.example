# Copie para .env.local (ignorado pelo Git). Nenhum segredo vai para o frontend.
# Modo de revisão local: mostra conteúdo pendente marcado e mídia com autorização pendente.
PUBLIC_REVISAO=1
# indisponivel (padrão) | simulado (testes, com aviso visível) | api (somente após validar o contrato)
PUBLIC_RESERVAS_MODO=indisponivel
# URL de STAGING da API FastAPI (preencher só depois do contrato validado)
PUBLIC_RESERVAS_API_URL=
